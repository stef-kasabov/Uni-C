#include <stdio.h>

float areaOfCircle(float radius) 
{
    floar result;
    result = 3.14 * radius * radius;
    return result;
}

int main() 
{
    float radius;
    printf("Enter the radius of the circle: ");
    scanf("%f", &radius);
    
    float area = areaOfCircle(radius);
